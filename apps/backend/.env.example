# Server
PORT=3000

# Database — DB_TYPE selects the TypeORM driver
# "sqlite" (default for local dev, uses sql.js — no install/admin rights needed) or "mssql" (production)
DB_TYPE=sqlite
DB_SQLITE_PATH=./data/dev.sqlite

# Only used when DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=
DB_DATABASE=workflow_brasal
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Microsoft Entra ID (Azure AD) SSO — leave all three blank until IT creates the App Registration
# and shares these values; the "Entrar com Microsoft" button stays hidden until they're set.
# ENTRA_REDIRECT_URI must exactly match a redirect URI registered on the App Registration —
# Entra ID accepts multiple, so http://localhost:5173/auth/entra/callback can be registered
# alongside the eventual production URL.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:5173/auth/entra/callback

# Used to build the e-mail verification / password-reset links
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30

# Jobs
APPROACHING_DEADLINE_WINDOW_HOURS=24

# Notifications: "console" (dev default, just logs — no external dependency) or "smtp" (real e-mail)
NOTIFICATION_CHANNEL=console
# Example values below are for Mailtrap's sandbox inbox (mailtrap.io — free, doesn't deliver to
# real inboxes, good for dev/testing). Get SMTP_USER/SMTP_PASSWORD from your own inbox's
# Email Testing > Inboxes > SMTP Settings page.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@brasal.local

# Throttler
THROTTLE_TTL=60
THROTTLE_LIMIT=100
