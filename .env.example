# Copy to .env and fill in before running `docker compose up -d --build`.
# This file configures docker-compose.yml — it's separate from apps/backend/.env.example,
# which is only for running the backend directly (outside Docker) in local dev.

# SQL Server "sa" password. Must meet SQL Server's complexity rules: 8+ chars, with at least
# three of upper-case, lower-case, digits and symbols.
DB_PASSWORD=ChangeMe123!

# Any long random string — used to sign login tokens. Generate one with:
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Notifications: "console" (logs only, no email) or "smtp" (real e-mail — fill in SMTP_* below).
NOTIFICATION_CHANNEL=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@brasal.local

# Port on the host machine that serves the app (http://<server>:HTTP_PORT).
HTTP_PORT=80

# Public URL of the frontend — used to build the e-mail verification link. Should match
# http://<server>:HTTP_PORT once deployed.
FRONTEND_URL=http://localhost
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
